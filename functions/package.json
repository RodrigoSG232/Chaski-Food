{
  "name": "chaski-food-local-api",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test lib/test/*.test.js",
    "test:emulator": "node --test lib/test/*.emulator.js",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-chaski-hu15 --config ../firebase.json",
    "verify:package": "node scripts/verifyPackage.cjs"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "5.0.5",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "firebase-tools": "15.31.0",
    "typescript": "5.8.3"
  }
}
