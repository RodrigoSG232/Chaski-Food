{
  "name": "chaski-food-local-api",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test lib/test/*.test.js",
    "test:emulator": "node --test lib/test/*.emulator.js",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project demo-chaski-hu15 --config ../firebase.json",
    "lab:seed": "GCLOUD_PROJECT=demo-chaski-hu15 FIRESTORE_EMULATOR_HOST=127.0.0.1:8089 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node lib/test/lab/seed.js",
    "lab:reset": "GCLOUD_PROJECT=demo-chaski-hu15 FIRESTORE_EMULATOR_HOST=127.0.0.1:8089 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node lib/test/lab/reset.js",
    "marketplace:seed": "GCLOUD_PROJECT=demo-chaski-hu15 FIRESTORE_EMULATOR_HOST=127.0.0.1:8089 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 STORAGE_EMULATOR_HOST=http://127.0.0.1:9199 node lib/test/marketplace/seed.js",
    "marketplace:reset": "GCLOUD_PROJECT=demo-chaski-hu15 FIRESTORE_EMULATOR_HOST=127.0.0.1:8089 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 STORAGE_EMULATOR_HOST=http://127.0.0.1:9199 node lib/test/marketplace/reset.js",
    "marketplace:seed:permanent": "node lib/test/marketplace/permanentSeed.js",
    "verify:package": "node scripts/verifyPackage.cjs"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "5.0.5",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "firebase-tools": "15.31.0",
    "typescript": "5.8.3"
  }
}
