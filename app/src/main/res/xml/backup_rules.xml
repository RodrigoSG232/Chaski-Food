<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 6–11 (API 23–30); Android 12+ uses data_extraction_rules.xml with the same exclusions.
     Device-bound state must never be restored on another device or install:
     - sharedpref: Firebase Auth sessions (file names embed the app id, so the whole domain is excluded), FCM state,
       notification installation id/binding version, sign-out marker, pending commercial attempts and permission flags.
     - DataStore session (uid and token) and the Firestore offline cache of a previous session.
     Room (chaski_food.db: carts and checkout intents scoped by UID) keeps the default behaviour. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/chaski_session.preferences_pb" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.chaski-food-9adba.%28default%29" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.chaski-food-9adba.%28default%29-journal" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.demo-chaski-hu15.%28default%29" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.demo-chaski-hu15.%28default%29-journal" />
</full-backup-content>
